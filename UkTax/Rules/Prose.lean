import UkTax.Rules.S35
import UkTax.Rules.Render

/-!
# The s35 documents

`docs/prose/s35.md` (plain English) and `docs/prose/s35-statute.md` (statute
layout), printed from `personalAllowanceRule` and `mainRates`, the values the
equivalence theorems in `UkTax/Rules/S35.lean` are about.
`lake env lean --run Prose.lean` writes them; CI regenerates them and fails if they differ from what is committed.
-/

namespace UkTax.Rules

/-- s35 as a section that gives an amount. -/
def s35 : AmountSection where
  number := "35"
  heading := "Personal allowance"
  who := "an individual"
  what := "a personal allowance"
  short := "the allowance"
  plainName := "your personal allowance"
  plainHeading := "Personal allowance (ITA 2007 s35)"
  rule := personalAllowanceRule
  examples := [9_000_000, 10_000_000, 10_000_100, 11_000_100, 12_000_000,
    12_514_000, 15_000_000]

/-- s10 (with the rates of s6) as a charge in bands. -/
def s10 : BandsSection where
  number := "10"
  heading := "Income charged at the basic, higher and additional rates: individuals"
  schedule := mainRates
  plainHeading := "Income tax bands and rates (ITA 2007 s6 and s10)"
  examples := [1_200_000, 3_770_000, 5_000_000, 12_514_000, 20_000_000]

/-- Where the text comes from, at the top of each file. -/
def provenance (year : String) : String :=
  s!"<!-- Generated by `lake env lean --run Prose.lean` from UkTax/Rules/S35.lean. Do not edit: \
    CI fails if this file differs from what the code prints. -->\n\n\
    Figures: {year}. The rules this text is printed from are proved equal to the \
    model's own definitions for every input and every parameter set \
    (`personalAllowanceRule_eval`, `mainRates_eval`); see \
    [README.md](README.md) for what that does and does not cover.\n\n"

/-- The plain-English document. -/
def plainDoc (P : TaxParams) (year : String) : String :=
  s!"# Personal allowance and income tax bands, in plain English\n\n" ++
    provenance year ++ s35.plain P ++ s10.plain P

/-- The statute-layout document. -/
def statuteDoc (P : TaxParams) (year : String) : String :=
  s!"# Personal allowance and income tax bands, statute layout\n\n" ++
    provenance year ++ s35.statute P ++
    s10.statuteRates "6" "The basic rate, higher rate and additional rate" year P ++
    s10.statute P

end UkTax.Rules
