import UkTax.Rules.S35
import UkTax.Rules.Hicbc
import UkTax.Rules.UcTaper
import UkTax.Rules.Class1
import UkTax.Rules.Render

/-!
# The documents

`docs/prose/s35.md` (plain English) and `docs/prose/s35-statute.md` (statute
layout), printed from `personalAllowanceRule` and `mainRates`, the values the
equivalence theorems in `UkTax/Rules/S35.lean` are about; `hicbc.md`,
`uc-taper.md`, `class1.md` (plain English) and `class1-statute.md`, printed from
the rules in `Hicbc.lean`, `UcTaper.lean` and `Class1.lean`.
`lake env lean --run Prose.lean` writes them; CI regenerates them and fails if they differ from what is committed.
-/

namespace UkTax.Rules

/-- s35 as a section that gives an amount. -/
def s35 : AmountSection where
  number := "35"
  heading := "Personal allowance"
  who := "an individual"
  what := "a personal allowance"
  short := "the allowance"
  plainName := "your personal allowance"
  plainHeading := "Personal allowance (ITA 2007 s35)"
  rule := personalAllowanceRule
  examples := [9_000_000, 10_000_000, 10_000_100, 11_000_100, 12_000_000,
    12_514_000, 15_000_000]

/-- s10 (with the rates of s6) as a charge in bands. -/
def s10 : BandsSection where
  number := "10"
  heading := "Income charged at the basic, higher and additional rates: individuals"
  schedule := mainRates
  plainHeading := "Income tax bands and rates (ITA 2007 s6 and s10)"
  examples := [1_200_000, 3_770_000, 5_000_000, 12_514_000, 20_000_000]

/-- Where the text comes from, at the top of each file. -/
def provenance (year : String) (file : String := "S35")
    (theorems : String := "`personalAllowanceRule_eval`, `mainRates_eval`") : String :=
  s!"<!-- Generated by `lake env lean --run Prose.lean` from UkTax/Rules/{file}.lean. Do not edit: \
    CI fails if this file differs from what the code prints. -->\n\n\
    Figures: {year}. The rules this text is printed from are proved equal to the \
    model's own definitions for every input and every parameter set \
    ({theorems}); see \
    [README.md](README.md) for what that does and does not cover.\n\n"

/-- The plain-English document. -/
def plainDoc (P : TaxParams) (year : String) : String :=
  s!"# Personal allowance and income tax bands, in plain English\n\n" ++
    provenance year ++ s35.plain P ++ s10.plain P

/-- The statute-layout document. -/
def statuteDoc (P : TaxParams) (year : String) : String :=
  s!"# Personal allowance and income tax bands, statute layout\n\n" ++
    provenance year ++ s35.statute P ++
    s10.statuteRates "6" "The basic rate, higher rate and additional rate" year P ++
    s10.statute P

/-! ## The High Income Child Benefit Charge -/

/-- Child Benefit for two children for a year of 52 weeks, for the examples. -/
def cbTwoChildren : Nat := childBenefitFor 2 52

/-- ITEPA 2003 s681C as a section that gives an amount. -/
def s681C : AmountSection where
  number := "681C"
  heading := "The amount of the charge"
  who := "a person"
  what := "a high income child benefit charge"
  short := "the charge"
  plainName := "the High Income Child Benefit Charge"
  plainHeading := "High Income Child Benefit Charge (ITEPA 2003 s681C)"
  rule := hicbcRule
  examples := [6_000_000, 6_019_999, 6_020_000, 7_000_000, 7_999_999, 8_000_000, 9_000_000]
  exampleKey := some adjustedNetIncome.key
  exampleEnv := fun k => if k = childBenefitIn.key then cbTwoChildren else 0
  exampleNote := s!", with {money cbTwoChildren} of Child Benefit (two children for 52 weeks)"

/-- The plain-English HICBC document. -/
def hicbcDoc (P : TaxParams) (year : String) : String :=
  "# High Income Child Benefit Charge, in plain English\n\n" ++
    provenance year "Hicbc" "`hicbcRule_eval`" ++ s681C.plain P ++
    "At 100% the charge equals the Child Benefit rounded down to the pound, so above \
      that income none of the Child Benefit is kept.\n"

/-! ## The Universal Credit taper -/

/-- The work allowances, from the table in reg 22. -/
def workAllowanceTable : String :=
  table ["Your situation", "Work allowance a month"]
    [["Responsible for a child, or limited capability for work, and no housing costs in the award",
        money ucWorkAllowanceHigher],
     ["Responsible for a child, or limited capability for work, with housing costs in the award",
        money ucWorkAllowanceLower],
     ["Anyone else", "none (£0)"]] ++ "\n"

/-- UC Regulations 2013 reg 22 as a section that gives an amount. -/
def reg22 : AmountSection where
  number := "22"
  heading := "Deduction of income and work allowance"
  who := "a claimant"
  what := "a deduction"
  short := "the deduction"
  plainName := "the amount your earnings take off your Universal Credit"
  plainHeading := "Universal Credit: the taper and the work allowance (UC Regulations 2013 reg 22)"
  rule := ucTaperRule
  examples := [30_000, 71_000, 100_000, 200_000, 300_000]
  exampleKey := some earnedIncomeIn.key
  exampleEnv := fun k => if k = workAllowanceIn.key then ucWorkAllowanceHigher else 0
  exampleNote := s!", for a month, with the higher work allowance of {money ucWorkAllowanceHigher}"
  extra := fun _ => workAllowanceTable ++
    "Your Universal Credit for the month is your maximum amount (the standard \
      allowance and any amounts for children, housing, childcare and so on), less any \
      unearned income, less the amount worked out above. If that leaves less than £0, \
      you get none.\n\n"

/-- The plain-English UC taper document. -/
def ucTaperDoc (P : TaxParams) (year : String) : String :=
  "# Universal Credit taper and work allowance, in plain English\n\n" ++
    provenance year "UcTaper" "`ucTaperRule_eval`, `ucAward_eq_rule`" ++ reg22.plain P

/-! ## Employee Class 1 National Insurance -/

/-- The thresholds for each way of being paid. -/
def class1Periods (P : TaxParams) : String :=
  "These are the weekly figures. If you are paid monthly, or once a year (as some \
    company directors are), the same bands apply with these figures instead:\n\n" ++
  table ["Paid", "Primary threshold", "Upper earnings limit"]
    [["Weekly", money P.ptWeekly, money P.uelWeekly],
     ["Monthly", money P.ptMonthly, money P.uelMonthly],
     ["Yearly", money P.ptAnnual, money P.uelAnnual]] ++
  "\nNational Insurance is worked out for each pay period separately, so with \
    uneven pay the year's total depends on how the pay is spread.\n\n"

/-- SSCBA 1992 s8 as a charge in bands, with the weekly thresholds. -/
def s8 : BandsSection where
  number := "8"
  heading := "Calculation of primary Class 1 contributions"
  schedule := class1Weekly
  plainHeading := "Employee National Insurance, Class 1 (SSCBA 1992 s8)"
  examples := [20_000, 24_200, 50_000, 96_700, 150_000]
  what := "Employee National Insurance"
  statuteOpen := "Where a primary Class 1 contribution is payable, the amount of that \
    contribution is the aggregate of"
  ofStyle := true
  ratesSubsection := true
  extra := class1Periods

/-- The plain-English Class 1 document. -/
def class1Doc (P : TaxParams) (year : String) : String :=
  "# Employee National Insurance, in plain English\n\n" ++
    provenance year "Class1" "`class1Weekly_eval`, `class1For_eval`" ++ s8.plain P

/-- The statute-layout Class 1 document. -/
def class1StatuteDoc (P : TaxParams) (year : String) : String :=
  "# Employee National Insurance, statute layout\n\n" ++
    provenance year "Class1" "`class1Weekly_eval`, `class1For_eval`" ++ s8.statute P

end UkTax.Rules
